digraph finite_state_machine {
	rankdir=LR;
  edge [margin = 0.1];
  node [shape=point] start;
	node [shape = circle];

  start -> "(q_0, r_0)";
  "(q_0, r_0)" -> "(q_1, r_0)" [label = 1];
  node [shape = doublecircle] "(q_0, r_1)";
  "(q_0, r_0)" -> "(q_0, r_1)" [label = 0];
  "(q_1, r_0)" -> "(q_0, r_1)" [label = 0];
  node [shape = doublecircle] "(q_2, r_0)";
  "(q_1, r_0)" -> "(q_2, r_0)" [label = 1];
  "(q_0, r_1)" -> "(q_0, r_1)" [label = 0];
  "(q_0, r_1)" -> "(q_1, r_0)" [label = 1];
  node [shape = doublecircle] "(q_1, r_1)";
  "(q_1, r_1)" -> "(q_0, r_1)" [label = 0];
  "(q_1, r_1)" -> "(q_2, r_0)" [label = 1];
  "(q_2, r_0)" -> "(q_2, r_0)" [label = 1];
  node [shape = doublecircle] "(q_2, r_1)";
  "(q_2, r_0)" -> "(q_2, r_1)" [label = 0];
  "(q_2, r_1)" -> "(q_2, r_0)" [label = 1];
  "(q_2, r_1)" -> "(q_2, r_1)" [label = 1];
}