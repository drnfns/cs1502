digraph nfa {
	rankdir=LR;
  edge [margin = 0.1];
	node [shape = doublecircle] q_3;
  node [shape=point] start;
	node [shape = circle];

  start -> q_0;
  q_0 -> q_0 [label = "0, 1"];
  q_0 -> q_1 [label = "1"];
  q_1 -> q_2 [label = "0, ε"];
  q_2 -> q_3 [label = "1"];
  q_3 -> q_3 [label = "0, 1"];
}