digraph dfa {
  rankdir=LR;
  node [shape = doublecircle]; A B C;
  node [shape = circle]; T;
  node [shape = point]; start;

  start -> A;
  A [label="{1,2}"];
  B [label="{1,2,3}"];
  C [label="{2,3}"];
  T [label="trap"];

  A -> B [label="a"];
  A -> T [label="b"];
  B -> B [label="a"];
  B -> C [label="b"];
  C -> A [label="a"];
  C -> C [label="b"];
  T -> T [label="a,b"];
}