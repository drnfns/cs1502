digraph finite_state_machine {
	rankdir=LR;
  bgcolor = "transparent";
  edge [margin = 0.1];
	node [shape = doublecircle] q_1;
  node [shape=point] start;
	node [shape = circle];

  start -> q_0;
  q_0 -> q_0 [label = "1"];
  q_0 -> q_1 [label = "0"];
  q_1 -> q_1 [label = "0"];
  q_1 -> q_0 [label = "1"];
}