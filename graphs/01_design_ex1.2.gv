digraph finite_state_machine {
	rankdir=LR;
  edge [margin = 0.1];
  node [shape=point] start;
	node [shape = circle];

  start -> q_0;
  q_0 -> q_1 [label = "0"];
  q_1 -> q_1 [label = "0"];
  q_1 -> q_2 [label = "1"];
  q_2 -> q_1 [label = "1"];
  q_2 -> q_2 [label = "0"];
  q_0 -> q_2 [label = "1"];
}